baseopt_echo


# 1 "mc_line 98 file /root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3 exp. def. part of mc cmd. before ze"
; dimension 3D; AQ_mode  (F2) QF (F1) Echo-Antiecho
define delay MCWRK
define delay MCREST
define loopcounter l11orig
"l11orig=l11"
define delay d10orig
"d10orig=d10"
define loopcounter l0orig
"l0orig=l0"
define loopcounter t2loop
"t2loop=0"
define loopcounter t1loop
"t1loop=0"
define loopcounter ph1loop
"ph1loop=0"
define loopcounter ph2loop
"ph2loop=0"
define loopcounter F2CNT
"F2CNT = min( 2 , td2)"
define loopcounter F1CNT
"F1CNT = min( 1 , td1)"
define loopcounter ST2CNT
"ST2CNT = max( 1 , trunc(td2 / 2))"
define loopcounter ST1CNT
"ST1CNT = max( 1 , trunc(td1 / 1))"
"MCREST = d11 - d11"
"MCWRK = 0.038462*d11"
# 98 "/root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3"
1 ze 
# 1 "mc_line 98 file /root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3 exp. def. of mc cmd. after ze"
LBLAV, MCWRK
      "l11 = l11orig + t1loop * 1"

      "d10=d10orig + t2loop * in10 "
      "phval7 = (ph2loop % 2) * 180"
      MCWRK ip7 + phval7
      "phval9 = (ph2loop % 2) * 180"
      MCWRK ip9 + phval9
      "phval5 = (t2loop * 180)%360"
      MCWRK ip5 + phval5
      "phval6 = (t2loop * 180)%360"
      MCWRK ip6 + phval6
      "phval31 = (t2loop * 180)%360"
      MCWRK ip31 + phval31
      MCWRK
      "phval0 = ph2loop * 1"
      MCWRK setgrad EA
      "l0 = l0orig + ph2loop * 1"

# 99 "/root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3"
# 1 "mc_line 99 file /root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3 exp. start label for mc cmd."
2 MCWRK  * 8
LBLST1, MCWRK  * 9
LBLF2, MCWRK  * 8
LBLST2, MCWRK
  MCREST
# 100 "/root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3"
# 101 "/root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3"
  (p21 ph1):f3
3 d1 pl1:f1 pl3:f3
  20u fq=cnst19(bf ppm):f1

  if "l11 %2 == 0"
     {
     d31
     }
  else
     {
4    11m
     (p2 ph1)
     11m
     lo to 4 times l4
     }

  20u fq=0:f1 
  50u setrtp0|0 ctrlgrad 0
# 120 "/root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3"
  if "l0 %2 == 1"
     {
     (p21 ph5):f3
     DELTA1
     2u
     p19:gp4*EA*-1
     d16
     (center (p11:sp1 ph3 2u 2u pl1 p1 ph1 p0 ph2 p1 ph1 4u p11:sp1 ph10:r):f1 (p22 ph5):f3 )
     2u
     p19:gp4*EA
     d16 pl1:f1
     DELTA2
     }
  else
     {
     (p21 ph6):f3
     DELTA1
     2u
     p19:gp4*EA*-1
     d16
     (center (p11:sp1 ph3 2u 2u pl1 p1 ph1 p0 ph2 p1 ph1 4u p11:sp1 ph10:r):f1 (p22 ph6):f3 )
     2u
     p19:gp4*EA
     d16 pl1:f1
     DELTA2
     }


  d10
  (p8:sp13 ph1):f2
  d10
# 156 "/root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3"
  (p1 ph7)
  4u
  (p11:sp1 ph7):f1
  p16:gp5
  d16
  DELTA3 pl1:f1
  (center (p2 ph1) (p22 ph1):f3 )
  DELTA3
  p16:gp5
  d16
  (p11:sp1 ph3):f1
  2u
  2u pl1:f1
  (p1 ph1) 
  (p21 ph7):f3

  4u
  p19:gp6
  d16
  (center (DELTA5 p11:sp1 ph8:r 2u 2u pl1 p2 ph1 4u p11:sp1 ph8:r):f1 (DELTA4 p22 ph1 DELTA4):f3 )
  4u
  p19:gp6
  d16
  (p21 ph1):f3
  p29:gp7
  d16
  4u setrtp0^0 ctrlgrad 4047

  go=2 ph31
# 1 "mc_line 185 file /root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3 exp. mc cmd. in line"
  MCWRK  wr #0 if #0 zd 

  "t1loop+=1 * (1 - kronecker_delta(1 , td1) )"
      "l11 = l11orig + t1loop * 1"

      "d10=d10orig + t2loop * in10 "
      "phval7 = (ph2loop % 2) * 180"
      MCWRK ip7 + phval7
      "phval9 = (ph2loop % 2) * 180"
      MCWRK ip9 + phval9
      "phval5 = (t2loop * 180)%360"
      MCWRK ip5 + phval5
      "phval6 = (t2loop * 180)%360"
      MCWRK ip6 + phval6
      "phval31 = (t2loop * 180)%360"
      MCWRK ip31 + phval31
      MCWRK
      "phval0 = ph2loop * 1"
      MCWRK setgrad EA
      "l0 = l0orig + ph2loop * 1"

  lo to LBLST1 times ST1CNT
  MCWRK 
  "t1loop=0"
  MCWRK 

  "ph2loop+=1 * (1 - kronecker_delta(1 , td2) )"
      "l11 = l11orig + t1loop * 1"

      "d10=d10orig + t2loop * in10 "
      "phval7 = (ph2loop % 2) * 180"
      MCWRK ip7 + phval7
      "phval9 = (ph2loop % 2) * 180"
      MCWRK ip9 + phval9
      "phval5 = (t2loop * 180)%360"
      MCWRK ip5 + phval5
      "phval6 = (t2loop * 180)%360"
      MCWRK ip6 + phval6
      "phval31 = (t2loop * 180)%360"
      MCWRK ip31 + phval31
      MCWRK
      "phval0 = ph2loop * 1"
      MCWRK setgrad EA
      "l0 = l0orig + ph2loop * 1"

  lo to LBLF2 times F2CNT
  MCWRK 

  "t2loop+=1 * (1 - kronecker_delta(1 , td2) )"
      "l11 = l11orig + t1loop * 1"

      "d10=d10orig + t2loop * in10 "
      "phval7 = (ph2loop % 2) * 180"
      MCWRK ip7 + phval7
      "phval9 = (ph2loop % 2) * 180"
      MCWRK ip9 + phval9
      "phval5 = (t2loop * 180)%360"
      MCWRK ip5 + phval5
      "phval6 = (t2loop * 180)%360"
      MCWRK ip6 + phval6
      "phval31 = (t2loop * 180)%360"
      MCWRK ip31 + phval31
      MCWRK
      "phval0 = ph2loop * 1"
      MCWRK setgrad EA
      "l0 = l0orig + ph2loop * 1"

  lo to LBLST2 times ST2CNT
  MCWRK 
  "t2loop=0"
  "ph2loop=0"
  MCWRK rf #0
  lo to LBLAV times tdav
# 188 "/root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3"
exit 
  
# 191 "/root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3"
ph1=0
ph2=1
ph3=2
ph5=2 1 0 3
ph6=2 3 0 1
ph7=1
ph8=2
ph9=3
ph10=(12) 1
ph31=1 2 3 0


;pl1 : f1 channel - power level for pulse (default)
;pl3 : f3 channel - power level for pulse (default)
;sp1 : f1 channel - shaped pulse 180 degree
;sp13: f2 channel - shaped pulse 180 degree (adiabatic)
;p0 : f1 channel - 210 degree high power pulse
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;p8 : f2 channel - 180 degree shaped pulse for inversion (adiabatic)
;p11: f1 channel -  90 degree shaped pulse
;p16: homospoil/gradient pulse                       [1 msec]
;p19: gradient pulse 2                               [500 usec]
;p21: f3 channel -  90 degree high power pulse
;p22: f3 channel - 180 degree high power pulse
;p29: gradient pulse 3                               [250 usec]
;d1 : relaxation delay; 1-5 * T1
;d10: incremented delay (F2 in 3D)                   [3 usec]
;d11: delay for disk I/O                             [30 msec]
;d16: delay for homospoil/gradient recovery
;d21: saturation time								 [5 s]
;d26: 1/(4J)YH                                       [2.65 msec]
;d31: saturation and reference time as executed (= l4 * (p2+22m))
;l4: loop for saturation sequence (= d21 / (p2+22m))
;cnst4: = J(YH)
;cnst19: H(N) chemical shift (offset, in ppm)
;inf2: 1/SW(X) = 2 * DW(X)
;in10: 1/(2 * SW(X)) = DW(X)
;nd10: 2
;ns: 4 * n
;ds: >= 16
;td1: = 2 
;td2: number of experiments in F2
;FnMODE: QF(no-frequency) in F1
;FnMODE: echo-antiecho in F2
# 238 "/root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3"
;for z-only gradients:
;gpz4: 40%
;gpz5: 11%
;gpz6: 47%
;gpz7: 16.2%

;use gradient files:
;gpnam4: SMSQ10.50
;gpnam5: SMSQ10.100
;gpnam6: SMSQ10.50
;gpnam7: SMSQ10.32

# 251 "/root/.topspin-BladeEpu/local_acqu/kleo_CRT_CTD_relax_241218/21/lists/pp/trnoeetf3gpsi3d.3"
