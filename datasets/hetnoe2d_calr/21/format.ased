EDIT_PAR COMMAND FILE

DI_MODE         LONG
ED_ENTRY        ACQU
ORDER           FILE


HEADER		"====== General ======"
NAME		PULPROG
END
NAME		TD
END
NAME		SW
END
T_NAME		SWH
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"SWH=SW*SFO1"
		INV_REL "SW=SWH/SFO1"
		UNIT	"Hz"
		FORMAT	"%14.2f Hz"
		TEXT	"sweep width in acquisition direction"
END
T_NAME          AQ
		TYPE	R32
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"AQ=aqcalc(SW,SFO1,TD,DIGTYP,FnMODE)"
		INV_REL	"TD=tdcalc(SW,SFO1,1.0e6*AQ,DIGTYP,FnMODE)"
		UNIT	"sec"
		FORMAT	"%14.7f sec"
                TEXT	"acquisition time"
END
NAME		RG
END
T_NAME          DW
		TYPE	R32
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"DW=1/(2*SW*SFO1)"
		INV_REL	"SW=1000000/(2*(0.005+DW)*SFO1)"
		UNIT	"usec"
		FORMAT	"%14.3f usec"
		TEXT	"dwell time "
END
NAME		DE
		FORMAT	"%14.2f usec"
END
T_NAME		GRPDLY
		TYPE	R64
		SUBRANGE 0 1e38
		CLASS	ACQU
		REL	"GRPDLY=GRPDLY"
		INV_REL	"GRPDLY=GRPDLY"				
		UNIT	"no"
		TEXT	"group delay of digital filter"
		FORMAT	"%14.0f"
		NONEDIT
END
T_NAME		D1
		TYPE	R32
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"D1=D[1]"
		INV_REL	"D[1]=D1"
		UNIT	"sec"
		FORMAT	"%14.9f sec"
		TEXT		"relaxation delay; 1-5 * T1"
END
T_NAME		d10
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d10=3u"
		INV_REL	"D[0]=d10"
		UNIT	"sec"
		TEXT		"incremented delay (F2 in 3D)                   [3 usec]"
		FORMAT	"%14.10f sec"
		NONEDIT
END
T_NAME		d11
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d11=30m"
		INV_REL	"D[0]=d11"
		UNIT	"sec"
		TEXT		"delay for disk I/O                             [30 msec]"
		FORMAT	"%14.10f sec"
		NONEDIT
END
T_NAME		D16
		TYPE	R32
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"D16=D[16]"
		INV_REL	"D[16]=D16"
		UNIT	"sec"
		FORMAT	"%14.9f sec"
		TEXT		"delay for homospoil/gradient recovery"
END
T_NAME		D21
		TYPE	R32
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"D21=D[21]"
		INV_REL	"D[21]=D21"
		UNIT	"sec"
		FORMAT	"%14.9f sec"
		TEXT		"saturation time								 [5 s]"
END
T_NAME		d26
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d26=2.65m"
		INV_REL	"D[0]=d26"
		UNIT	"sec"
		TEXT		"1/(4J)YH                                       [2.65 msec]"
		FORMAT	"%14.10f sec"
		NONEDIT
END
T_NAME		d31
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d31=(p2+22m)*l4"
		INV_REL	"D[0]=d31"
		UNIT	"sec"
		TEXT		"saturation and reference time as executed (= l4 * (p2+22m))"
		FORMAT	"%14.10f sec"
		NONEDIT
END
T_NAME		DELTA1
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"DELTA1=d26-p19-d16-p11-6u-p1-p0/2-p21*4/PI"
		INV_REL	"D[0]=DELTA1"
		UNIT	"sec"
		TEXT	"DELTA1=d26-p19-d16-p11-6u-p1-p0/2-p21*4/PI"
		FORMAT	"%14.10f sec"
		NONEDIT
END
T_NAME		DELTA2
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"DELTA2=d26-p19-d16-p11-6u-p1-p0/2-d10*2-p8-p1"
		INV_REL	"D[0]=DELTA2"
		UNIT	"sec"
		TEXT	"DELTA2=d26-p19-d16-p11-6u-p1-p0/2-d10*2-p8-p1"
		FORMAT	"%14.10f sec"
		NONEDIT
END
T_NAME		DELTA3
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"DELTA3=d26-p11-p16-d16-4u"
		INV_REL	"D[0]=DELTA3"
		UNIT	"sec"
		TEXT	"DELTA3=d26-p11-p16-d16-4u"
		FORMAT	"%14.10f sec"
		NONEDIT
END
T_NAME		DELTA4
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"DELTA4=d26-p19-d16-p29/2-d16/2-2u"
		INV_REL	"D[0]=DELTA4"
		UNIT	"sec"
		TEXT	"DELTA4=d26-p19-d16-p29/2-d16/2-2u"
		FORMAT	"%14.10f sec"
		NONEDIT
END
T_NAME		DELTA5
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"DELTA5=p29+d16+4u+de-p1*2/PI"
		INV_REL	"D[0]=DELTA5"
		UNIT	"sec"
		TEXT	"DELTA5=p29+d16+4u+de-p1*2/PI"
		FORMAT	"%14.10f sec"
		NONEDIT
END
NAME		DS
		TEXT		">= 16"
END
T_NAME		F2CNT
		TYPE	I32
		SUBRANGE 0 2147483647
		CLASS	ACQU
		REL	"F2CNT = min( 2 , td2)"
		INV_REL	"D[0]=F2CNT"
		UNIT	"no"
		TEXT	"F2CNT = min( 2 , td2)"
		FORMAT	"%14d"
		NONEDIT
END
T_NAME		in10
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"in10=inf2/2"
		INV_REL	"D[0]=in10"
		UNIT	"sec"
		TEXT		"1/(2 * SW(X)) = DW(X)"
		FORMAT	"%14.10f sec"
		NONEDIT
END
T_NAME		INF2
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"INF2=INF[2]"
		INV_REL	"INF[2]=INF2"
		UNIT	"usec"
		FORMAT	"%14.4f usec"
		TEXT		"1/SW(X) = 2 * DW(X)"
		NONEDIT
END
T_NAME		l0
		TYPE	I32
		SUBRANGE 0 2147483647
		CLASS	ACQU
		REL	"l0=1"
		INV_REL	"D[0]=l0"
		UNIT	"no"
		TEXT	"l0=1"
		FORMAT	"%14d"
		NONEDIT
END
T_NAME		l4
		TYPE	I32
		SUBRANGE 0 2147483647
		CLASS	ACQU
		REL	"l4=d21/(p2+22m)"
		INV_REL	"D[0]=l4"
		UNIT	"no"
		TEXT		"loop for saturation sequence (= d21 / (p2+22m))"
		FORMAT	"%14d"
		NONEDIT
END
T_NAME		l11
		TYPE	I32
		SUBRANGE 0 2147483647
		CLASS	ACQU
		REL	"l11=0"
		INV_REL	"D[0]=l11"
		UNIT	"no"
		TEXT	"l11=0"
		FORMAT	"%14d"
		NONEDIT
END
NAME		NS
		TEXT		"4 * n"
END
NAME		TDav	
		TEXT	"number of averages in nD"
END
NAME		ZGOPTNS
		TEXT 	"options for zg"
END
T_NAME		l0orig
		TYPE	I32
		SUBRANGE 0 2147483647
		CLASS	ACQU
		REL	"l0orig=l0"
		INV_REL	"D[0]=l0orig"
		UNIT	"no"
		TEXT	"l0orig=l0"
		FORMAT	"%14d"
		NONEDIT
END
T_NAME		l11orig
		TYPE	I32
		SUBRANGE 0 2147483647
		CLASS	ACQU
		REL	"l11orig=l11"
		INV_REL	"D[0]=l11orig"
		UNIT	"no"
		TEXT	"l11orig=l11"
		FORMAT	"%14d"
		NONEDIT
END
