		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d0 = 3u"
		INV_REL	"D[0]=d0"
		UNIT	"sec"
		TEXT	" "
		FORMAT	"%14.10f"
		NONEDIT
END
