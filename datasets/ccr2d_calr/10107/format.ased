EDIT_PAR COMMAND FILE

DI_MODE         LONG
ED_ENTRY        ACQU
ORDER           FILE


HEADER		"====== General ======"
NAME		PULPROG
END
NAME		TD
END
NAME		SW
END
T_NAME		SWH
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"SWH=SW*SFO1"
		INV_REL "SW=SWH/SFO1"
		UNIT	"Hz"
		FORMAT	"%14.2f"
		TEXT	"sweep width in acquisition direction"
END
T_NAME          AQ
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"AQ=aqcalc(SW,SFO1,TD,DIGTYP,FnMODE)"
		INV_REL	"TD=tdcalc(SW,SFO1,1.0e6*AQ,DIGTYP,FnMODE)"
		UNIT	"sec"
		FORMAT	"%14.7f"
                TEXT	"acquisition time"
END
NAME		RG
END
T_NAME          DW
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"DW=1/(2*SW*SFO1)"
		INV_REL	"SW=1000000/(2*(0.005+DW)*SFO1)"
		UNIT	"usec"
		FORMAT	"%14.3f"
		TEXT	"dwell time "
END
NAME		DE
		FORMAT	"%14.2f"
END
T_NAME		GRPDLY
		TYPE	R64
		SUBRANGE 0 1e38
		CLASS	ACQU
		REL	"GRPDLY=GRPDLY"
		INV_REL	"GRPDLY=GRPDLY"				
		UNIT	"no"
		TEXT	"group delay of digital filter"
		FORMAT	"%14.0f"
		NONEDIT
END
T_NAME		d0
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d0 = 3u"
		INV_REL	"D[0]=d0"
		UNIT	"sec"
		TEXT	"d0 = 3u"
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		D1
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"D1=D[1]"
		INV_REL	"D[1]=D1"
		UNIT	"sec"
		FORMAT	"%14.9f"
		TEXT		"relaxation delay; 1-5 * T1"
END
T_NAME		d2
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d2 = 2.7m"
		INV_REL	"D[0]=d2"
		UNIT	"sec"
		TEXT	"d2 = 2.7m"
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		d4
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d4 = d2-p16-d16-d15"
		INV_REL	"D[0]=d4"
		UNIT	"sec"
		TEXT	"d4 = d2-p16-d16-d15"
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		d5
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d5 = d2-p16-d16-d15-p11"
		INV_REL	"D[0]=d5"
		UNIT	"sec"
		TEXT	"d5 = d2-p16-d16-d15-p11"
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		d10
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d10 = p1*2+d0*2"
		INV_REL	"D[0]=d10"
		UNIT	"sec"
		TEXT	"d10 = p1*2+d0*2"
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		d15
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d15=5u"
		INV_REL	"D[0]=d15"
		UNIT	"sec"
		TEXT	"d15=5u"
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		d16
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d16=200u"
		INV_REL	"D[0]=d16"
		UNIT	"sec"
		TEXT	"d16=200u"
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		D20
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"D20=D[20]"
		INV_REL	"D[20]=D20"
		UNIT	"sec"
		FORMAT	"%14.9f"
		TEXT	"delay 20"
END
T_NAME		d22
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d22 = d2+p1+d0"
		INV_REL	"D[0]=d22"
		UNIT	"sec"
		TEXT	"d22 = d2+p1+d0"
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		d23
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d23 = d2-p1-d0-3u"
		INV_REL	"D[0]=d23"
		UNIT	"sec"
		TEXT	"d23 = d2-p1-d0-3u"
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		d24
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d24 = d20*0.5-d15-p16-d16-p2-p2*0.637"
		INV_REL	"D[0]=d24"
		UNIT	"sec"
		TEXT	"d24 = d20*0.5-d15-p16-d16-p2-p2*0.637"
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		d30
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d30 = 30m"
		INV_REL	"D[0]=d30"
		UNIT	"sec"
		TEXT	"d30 = 30m"
		FORMAT	"%14.10f"
		NONEDIT
END
NAME		DS
		TEXT	"number of dummy scans"
END
T_NAME		in0
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"in0=inf1/2"
		INV_REL	"D[0]=in0"
		UNIT	"sec"
		TEXT	"in0=inf1/2"
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		INF1
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"INF1=INF[1]"
		INV_REL	"INF[1]=INF1"
		UNIT	"usec"
		FORMAT	"%14.4f"
		TEXT	"increment for F1"
		NONEDIT
END
T_NAME		l5
		TYPE	I32
		SUBRANGE 0 2147483647
		CLASS	ACQU
		REL	"l5=1"
		INV_REL	"D[0]=l5"
		UNIT	"no"
		TEXT	"l5=1"
		FORMAT	"%14d"
		NONEDIT
END
NAME		NS
		TEXT	"scans to execute"
END
NAME		TDav	
		TEXT	"number of averages in nD"
END
HEADER		"======== CHANNEL f1 ========"
NAME		SFO1
		FORMAT	"%14.7f"
		TEXT	"frequency of ch. 1"
END
NAME		O1
		FORMAT	"%14.2f"
		TEXT	"frequency of ch. 1"
END
T_NAME		O1P
		TYPE	R64
		CLASS	ACQU
		SUBRANGE -1e38 1e38
		REL	"O1P=O1/BF1"
		INV_REL	"O1=O1P*BF1"
		UNIT	"ppm"
		FORMAT	"%14.3f"
		TEXT	"frequency of ch. 1"
END
NAME		NUC1
		NONEDIT
		TEXT	"nucleus for channel 1"
END
T_NAME		P1
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1.0e10
		REL	"P1=P[1]"
		INV_REL	"P[1]=P1"
		UNIT	"usec"
		FORMAT	"%14.4f"
		TEXT		"f1 channel -  high power pulse"
END
T_NAME		P11
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1.0e10
		REL	"P11=P[11]"
		INV_REL	"P[11]=P11"
		UNIT	"usec"
		FORMAT	"%14.4f"
		TEXT	"pulse 11"
END
T_NAME		PLW0
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0 692.584
		REL	"PLW0=PLW[0]"
		INV_REL	"PLW[0]=PLW0"
		UNIT	"W"
		FORMAT	"%14.5g"
		TEXT	"power PLW0 "
END
T_NAME		PLdB0
		TYPE	R64
		CLASS	ACQU
		SUBRANGE -28.4047 1000
		REL	"if(PLW[0]>0)PLdB0=-10*log(PLW[0])/LN10;else PLdB0=1000;"
		INV_REL	"PLW[0]=0;if(PLdB0<1000)PLW[0]=pow(10.0,(-PLdB0)/10.0)"
		UNIT	"dB"
		FORMAT	"%14.4f"
		TEXT	"power PL0 in dB"
		EPSILON 1.000000e-08
END
T_NAME		PLW1
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0 692.584
		REL	"PLW1=PLW[1]"
		INV_REL	"PLW[1]=PLW1"
		UNIT	"W"
		FORMAT	"%14.5g"
		TEXT		"f1 channel - power level for pulse (default)"
END
T_NAME		PLdB1
		TYPE	R64
		CLASS	ACQU
		SUBRANGE -28.4047 1000
		REL	"if(PLW[1]>0)PLdB1=-10*log(PLW[1])/LN10;else PLdB1=1000;"
		INV_REL	"PLW[1]=0;if(PLdB1<1000)PLW[1]=pow(10.0,(-PLdB1)/10.0)"
		UNIT	"dB"
		FORMAT	"%14.4f"
		TEXT	"power PL1 in dB"
		EPSILON 1.000000e-08
END
NAME		SPNAM[1]
