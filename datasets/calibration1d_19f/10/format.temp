EDIT_PAR COMMAND FILE

DI_MODE         LONG
ED_ENTRY        ACQU
ORDER           FILE


HEADER		"F2 - Acquisition Parameters"
T_NAME		Date_
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 50000000
		REL	"Date_=itodate(DATE)"
		INV_REL	"DATE=datetoi(Date_,DATE)"
		FORMAT	"%14.0f"
		TEXT	" "
END
T_NAME		Time
		TYPE	R32
		CLASS	ACQU
		SUBRANGE 0.0 1000000
		REL	"Time=itotime(DATE)"
		INV_REL	"DATE=timetoi(Time,DATE)"
		UNIT	"h"
		FORMAT	"%14.2f"
		TEXT	" "
END
NAME		INSTRUM
		TEXT	" "
END
NAME		PROBHD
		FORMAT	"%14.14s"
		TEXT	" "
END
NAME		PULPROG
		TEXT	" "
END
NAME		TD
		TEXT	" "
END
NAME		SOLVENT
		TEXT	" "
END
NAME		NS
		TEXT	" "
END
NAME		DS
		TEXT	" "
END
T_NAME		SWH
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e8
		REL	"SWH=SW*SFO1"
		INV_REL "SW=SWH/SFO1"
		UNIT	"Hz"
		FORMAT	"%14.3f"
		TEXT	" "
END
T_NAME          FIDRES
                TYPE    R32
                CLASS   ACQU
                SUBRANGE 0.0 100000
                REL     "FIDRES=2*SW*SFO1/TD"
                INV_REL "TD = nextpow(2*SW*SFO1/FIDRES)"
		UNIT	"Hz"
		FORMAT	"%14.6f"
		TEXT	" "
END
T_NAME          AQ
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1000
		REL	"AQ=aqcalc(SW,SFO1,TD,DIGTYP)"
		INV_REL	"TD=tdcalc(SW,SFO1,1.0e6*AQ,DIGTYP)"
		UNIT	"sec"
		FORMAT	"%14.7f"
		TEXT	" "
END
NAME		RG
		TEXT	" "
END
T_NAME          DW
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1000000
		REL	"DW=1/(2*SW*SFO1)"
		INV_REL	"SW=1000000/(2*(0.005+DW)*SFO1)"
		UNIT	"usec"
		FORMAT	"%14.3lf"
		TEXT	" "
END
NAME		DE
		FORMAT	"%14.2f"
		TEXT	" "
END
NAME		TE
		FORMAT	"%14.1f"
		TEXT	" "
END
T_NAME		CNST8
		TYPE	R32
		CLASS	ACQU
		SUBRANGE -1e38 1e38
		REL	"CNST8=CNST[8]"
		INV_REL	"CNST[8]=CNST8"
		FORMAT	"%14.7f"
		TEXT	" "
END
T_NAME		D1
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"D1=D[1]"
		INV_REL	"D[1]=D1"
		UNIT	"sec"
		FORMAT	"%14.8f"
		TEXT	" "
END
T_NAME		d11
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d11=30m"
		INV_REL	"D[0]=d11"
		UNIT	"sec"
		TEXT	" "
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		d12
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d12=20u"
		INV_REL	"D[0]=d12"
		UNIT	"sec"
		TEXT	" "
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		inp9
		TYPE	R32
		SUBRANGE -1e38 1e38
		CLASS	ACQU
		REL	"inp9=p8*0.5"
		INV_REL	"D[0]=inp9"
		UNIT	"usec"
		TEXT	" "
		FORMAT	"%14.3f"
		NONEDIT
END
T_NAME		p8
		TYPE	R32
		SUBRANGE -1e38 1e38
		CLASS	ACQU
		REL	"p8=1s/(cnst8*4)"
		INV_REL	"D[0]=p8"
		UNIT	"usec"
		TEXT	" "
		FORMAT	"%14.2f"
		NONEDIT
END
T_NAME		ST1CNT
		TYPE	I32
		SUBRANGE 0 2147483647
		CLASS	ACQU
		REL	"ST1CNT = max( 1 , trunc(td1 / 1))"
		INV_REL	"D[0]=ST1CNT"
		UNIT	"no"
		TEXT	" "
		FORMAT	"%14d"
		NONEDIT
END
NAME		TDav
		TEXT	" "
END
NAME		ZGOPTNS
		TEXT	" "
END
T_NAME		t1loop
		TYPE	I32
		SUBRANGE 0 2147483647
		CLASS	ACQU
		REL	"t1loop=0"
		INV_REL	"D[0]=t1loop"
		UNIT	"no"
		TEXT	" "
		FORMAT	"%14d"
		NONEDIT
END
NAME		SFO1
		FORMAT	"%14.7f"
		TEXT	" "
END
NAME		NUC1
		NONEDIT
		TEXT	" "
END
T_NAME		P1
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1.0e10
		REL	"P1=P[1]"
		INV_REL	"P[1]=P1"
		UNIT	"usec"
		FORMAT	"%14.2f"
		TEXT	" "
END
T_NAME		p9
		TYPE	R32
		SUBRANGE -1e38 1e38
		CLASS	ACQU
		REL	"p9=p8*0.5"
		INV_REL	"D[0]=p9"
		UNIT	"usec"
		TEXT	" "
		FORMAT	"%14.2f"
		NONEDIT
END
T_NAME		PLW1
		TYPE	R64
		CLASS	ACQU
		REL	"PLW1=PLW[1]"
		INV_REL	"PLW[1]=PLW1"
		UNIT	"W"
		FORMAT	"%14.8f"
		TEXT	"power PLW1 "
END
HEADER		"======== F1 INDIRECT DIMENSION ========"
T_NAME		td1
		TYPE	I32
		CLASS	ACQU
		SUBRANGE 1 2147483647
		REL	"td1=16"
		FORMAT	"%d"
		TEXT	"F1 Time domain size"
		NONEDIT
END
T_NAME		sw_F1
		TYPE	R32
		CLASS	ACQU
		SUBRANGE 0 1e38
		REL	"sw_F1=10.202139"
		UNIT	"ppm"
		FORMAT	"%f"
		TEXT	"F1 Sweep width [ppm]"
		NONEDIT
END
