EDIT_PAR COMMAND FILE

DI_MODE         LONG
ED_ENTRY        ACQU
ORDER           FILE


HEADER		"====== General ======"
NAME		PULPROG
END
NAME		TD
END
NAME		SW
END
T_NAME		SWH
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"SWH=SW*SFO1"
		INV_REL "SW=SWH/SFO1"
		UNIT	"Hz"
		FORMAT	"%14.2f"
		TEXT	"sweep width in acquisition direction"
END
T_NAME          AQ
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"AQ=aqcalc(SW,SFO1,TD,DIGTYP,FnMODE)"
		INV_REL	"TD=tdcalc(SW,SFO1,1.0e6*AQ,DIGTYP,FnMODE)"
		UNIT	"sec"
		FORMAT	"%14.7f"
                TEXT	"acquisition time"
END
NAME		RG
END
T_NAME          DW
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"DW=1/(2*SW*SFO1)"
		INV_REL	"SW=1000000/(2*(0.005+DW)*SFO1)"
		UNIT	"usec"
		FORMAT	"%14.3f"
		TEXT	"dwell time "
END
NAME		DE
		FORMAT	"%14.2f"
END
T_NAME		GRPDLY
		TYPE	R64
		SUBRANGE 0 1e38
		CLASS	ACQU
		REL	"GRPDLY=GRPDLY"
		INV_REL	"GRPDLY=GRPDLY"				
		UNIT	"no"
		TEXT	"group delay of digital filter"
		FORMAT	"%14.0f"
		NONEDIT
END
T_NAME		CNST8
		TYPE	R64
		CLASS	ACQU
		SUBRANGE -1e38 1e38
		REL	"CNST8=CNST[8]"
		INV_REL	"CNST[8]=CNST8"
		FORMAT	"%14.7f"
		TEXT		"nominal rf field in Hz (e.g. 60 for 60 Hz)"
END
T_NAME		D1
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1e38
		REL	"D1=D[1]"
		INV_REL	"D[1]=D1"
		UNIT	"sec"
		FORMAT	"%14.9f"
		TEXT		"relaxation delay; 3-5 * T1"
END
T_NAME		d11
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d11=30m"
		INV_REL	"D[0]=d11"
		UNIT	"sec"
		TEXT	"d11=30m"
		FORMAT	"%14.10f"
		NONEDIT
END
T_NAME		d12
		TYPE	R32
		SUBRANGE 0.0 1e8
		CLASS	ACQU
		REL	"d12=20u"
		INV_REL	"D[0]=d12"
		UNIT	"sec"
		TEXT	"d12=20u"
		FORMAT	"%14.10f"
		NONEDIT
END
NAME		DS
		TEXT	"number of dummy scans"
END
T_NAME		inp9
		TYPE	R32
		SUBRANGE -1e38 1e38
		CLASS	ACQU
		REL	"inp9=p8*0.5"
		INV_REL	"D[0]=inp9"
		UNIT	"usec"
		TEXT	"inp9=p8*0.5"
		FORMAT	"%14.3f"
		NONEDIT
END
NAME		NS
		TEXT	"scans to execute"
END
T_NAME		p8
		TYPE	R32
		SUBRANGE -1e38 1e38
		CLASS	ACQU
		REL	"p8=1s/(cnst8*4)"
		INV_REL	"D[0]=p8"
		UNIT	"usec"
		TEXT		"f1 channel -  90 degree pulse length at desired rf field"
		FORMAT	"%14.2f"
		NONEDIT
END
NAME		TDav	
		TEXT	"number of averages in nD"
END
NAME		ZGOPTNS
		TEXT 	"options for zg"
END
HEADER		"======== CHANNEL f1 ========"
NAME		SFO1
		FORMAT	"%14.7f"
		TEXT	"frequency of ch. 1"
END
NAME		O1
		FORMAT	"%14.2f"
		TEXT	"frequency of ch. 1"
END
T_NAME		O1P
		TYPE	R64
		CLASS	ACQU
		SUBRANGE -1e38 1e38
		REL	"O1P=O1/BF1"
		INV_REL	"O1=O1P*BF1"
		UNIT	"ppm"
		FORMAT	"%14.3f"
		TEXT	"frequency of ch. 1"
END
NAME		NUC1
		NONEDIT
		TEXT	"nucleus for channel 1"
END
T_NAME		P1
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0.0 1.0e10
		REL	"P1=P[1]"
		INV_REL	"P[1]=P1"
		UNIT	"usec"
		FORMAT	"%14.4f"
		TEXT		"f1 channel -  high power pulse"
END
T_NAME		p9
		TYPE	R32
		SUBRANGE -1e38 1e38
		CLASS	ACQU
		REL	"p9=p8*0.5"
		INV_REL	"D[0]=p9"
		UNIT	"usec"
		TEXT		"f1 channel -  pulse length increment for nutation (45 degree)"
		FORMAT	"%14.2f"
		NONEDIT
END
T_NAME		PLW1
		TYPE	R64
		CLASS	ACQU
		SUBRANGE 0 149.271
		REL	"PLW1=PLW[1]"
		INV_REL	"PLW[1]=PLW1"
		UNIT	"W"
		FORMAT	"%14.5g"
		TEXT		"f1 channel - power level for pulse (default)"
END
T_NAME		PLdB1
		TYPE	R64
		CLASS	ACQU
		SUBRANGE -21.7397 1000
		REL	"if(PLW[1]>0)PLdB1=-10*log(PLW[1])/LN10;else PLdB1=1000;"
		INV_REL	"PLW[1]=0;if(PLdB1<1000)PLW[1]=pow(10.0,(-PLdB1)/10.0)"
		UNIT	"dB"
		FORMAT	"%14.4f"
		TEXT	"power PL1 in dB"
		EPSILON 1.000000e-08
END
T_NAME		plw8
		TYPE	R32
		SUBRANGE 0 149.271
		CLASS	ACQU
		REL	"plw8=plw1*pow(p1/p8,2)"
		INV_REL	"D[0]=plw8"
		UNIT	"W"
		TEXT	"plw8=plw1*pow(p1/p8,2)"
		FORMAT	"%14.5g"
		NONEDIT
END
T_NAME		PLdB8
		TYPE	R64
		CLASS	ACQU
		SUBRANGE -21.7397 1000
		REL	"if(plw8>0)PLdB8=-10*log(plw8)/LN10;else PLdB8=1000;"
		INV_REL	"PLW[8]=0;if(PLdB8<1000)PLW[8]=pow(10.0,(-PLdB8)/10.0)"
		UNIT	"dB"
		FORMAT	"%14.4f"
		TEXT	"power PL8 in dB"
		EPSILON 1.000000e-08
		NONEDIT
END
HEADER		"======== F1 INDIRECT DIMENSION ========"
T_NAME		td1
		TYPE	I32
		CLASS	ACQU
		SUBRANGE 1 2147483647
		REL	"td1=16"
		FORMAT	"%d"
		TEXT	"F1 Time domain size"
		NONEDIT
END
T_NAME		sw_F1
		TYPE	R32
		CLASS	ACQU
		SUBRANGE 0 1e38
		REL	"sw_F1=10.202139"
		UNIT	"ppm"
		FORMAT	"%f"
		TEXT	"F1 Sweep width [ppm]"
		NONEDIT
END
